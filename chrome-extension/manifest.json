{
  "manifest_version": 3,
  "name": "BSE PDF Chrome Helper",
  "version": "1.0.0",
  "description": "Maximizes Chrome and opens BSE announcement PDFs from the BSE frontend.",
  "permissions": ["tabs", "windows"],
  "host_permissions": [
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*",
    "https://www.bseindia.com/*",
    "https://*.bseindia.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "BSE PDF Chrome Helper"
  }
}
